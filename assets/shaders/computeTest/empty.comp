#version 450 core

layout(local_size_x = 4) in;

layout(std430) buffer testBuffer
{
    // Match CPU-side payload of 16 bytes (vec4 == 4 floats)
    float data[4];
};

void main(void)
{
    uint i = gl_LocalInvocationID.x;
    //basic math operation to test compute shader functionality
    data[i] += float(i) * 0.1;
}